@* Views/Dashboard/Index.cshtml - Main landing page after login
   Displays stat cards with live counts from the repositories
   Data passed in via ViewBag from DashboardController *@

@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4">
    <i class="bi bi-speedometer2 me-2 text-primary"></i>Dashboard
</h2>
<p class="text-muted">Welcome back, <strong>@Context.Session.GetString("UserName")</strong>. Here's a snapshot of the library.</p>

@* ── Stat Cards Row ── *@
<div class="row g-4 mb-5">

    @* Total Books *@
    <div class="col-sm-6 col-xl-3">
        <div class="card text-white" style="background-color:#1a3c5e;">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-white-50">Total Books</div>
                    <div class="fs-2 fw-bold">@ViewBag.TotalBooks</div>
                </div>
                <i class="bi bi-journals fs-1 opacity-50"></i>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a asp-controller="Book" asp-action="Index" class="text-white-50 small">
                    View all <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    @* Available Books *@
    <div class="col-sm-6 col-xl-3">
        <div class="card text-white bg-success">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-white-50">Available Books</div>
                    <div class="fs-2 fw-bold">@ViewBag.AvailableBooks</div>
                </div>
                <i class="bi bi-bookmark-check fs-1 opacity-50"></i>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a asp-controller="Book" asp-action="Create" class="text-white-50 small">
                    Add book <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    @* Total Readers *@
    <div class="col-sm-6 col-xl-3">
        <div class="card text-white" style="background-color:#5b6e7e;">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-white-50">Registered Readers</div>
                    <div class="fs-2 fw-bold">@ViewBag.TotalReaders</div>
                </div>
                <i class="bi bi-people fs-1 opacity-50"></i>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a asp-controller="Reader" asp-action="Index" class="text-white-50 small">
                    View all <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    @* Overdue Borrowings *@
    <div class="col-sm-6 col-xl-3">
        <div class="card text-white @(ViewBag.OverdueBorrowings > 0 ? "bg-danger" : "bg-secondary")">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-white-50">Overdue</div>
                    <div class="fs-2 fw-bold">@ViewBag.OverdueBorrowings</div>
                </div>
                <i class="bi bi-exclamation-triangle fs-1 opacity-50"></i>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a asp-controller="Borrowing" asp-action="Index" class="text-white-50 small">
                    View borrowings <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

</div>

@* ── Quick Actions ── *@
<h5 class="mb-3">Quick Actions</h5>
<div class="row g-3">
    <div class="col-md-4">
        <a asp-controller="Book" asp-action="Create" class="btn btn-outline-primary w-100 py-3">
            <i class="bi bi-plus-circle me-2"></i>Add New Book
        </a>
    </div>
    <div class="col-md-4">
        <a asp-controller="Reader" asp-action="Create" class="btn btn-outline-secondary w-100 py-3">
            <i class="bi bi-person-plus me-2"></i>Register Reader
        </a>
    </div>
    <div class="col-md-4">
        <a asp-controller="Borrowing" asp-action="Create" class="btn btn-outline-dark w-100 py-3">
            <i class="bi bi-arrow-left-right me-2"></i>New Borrowing
        </a>
    </div>
</div>
