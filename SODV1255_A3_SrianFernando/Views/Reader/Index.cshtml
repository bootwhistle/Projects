@* Views/Reader/Index.cshtml - Table of all registered library readers *@

@model List<Reader>
@{
    ViewData["Title"] = "Readers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-people me-2 text-primary"></i>Readers</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus me-1"></i>Register Reader
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No readers registered yet. <a asp-action="Create">Add the first one.</a>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Registered</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reader in Model)
                    {
                        <tr>
                            <td>@reader.Id</td>
                            <td><strong>@reader.FullName</strong></td>
                            <td>@reader.Email</td>
                            <td>@reader.Phone</td>
                            <td>@reader.RegisteredDate.ToString("MMM dd, yyyy")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@reader.Id"
                                   class="btn btn-sm btn-outline-secondary me-1" title="Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@reader.Id"
                                   class="btn btn-sm btn-outline-primary me-1" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@reader.Id"
                                   class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <p class="text-muted small mt-2">@Model.Count reader(s) registered.</p>
}
