@* Views/Borrowing/Create.cshtml - Form to record a new book borrowing
   Staff selects a reader and an available book from dropdowns
   Borrow date defaults to today; due date defaults to 2 weeks from now *@

@model Borrowing
@{
    ViewData["Title"] = "New Borrowing";
}

<div class="row justify-content-center">
    <div class="col-md-7">

        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Borrowings</a></li>
                <li class="breadcrumb-item active">New Borrowing</li>
            </ol>
        </nav>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Record New Borrowing</h5>
            </div>
            <div class="card-body">

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    @* Reader dropdown - all registered readers *@
                    <div class="mb-3">
                        <label asp-for="ReaderId" class="form-label"></label>
                        <select asp-for="ReaderId" asp-items="ViewBag.Readers" class="form-select">
                            <option value="">-- Select a reader --</option>
                        </select>
                        <span asp-validation-for="ReaderId" class="text-danger small"></span>
                    </div>

                    @* Book dropdown - only currently available books *@
                    <div class="mb-3">
                        <label asp-for="BookId" class="form-label"></label>
                        <select asp-for="BookId" asp-items="ViewBag.Books" class="form-select">
                            <option value="">-- Select an available book --</option>
                        </select>
                        <span asp-validation-for="BookId" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="BorrowDate" class="form-label"></label>
                            <input asp-for="BorrowDate" class="form-control" type="date" />
                            <span asp-validation-for="BorrowDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label asp-for="DueDate" class="form-label"></label>
                            <input asp-for="DueDate" class="form-control" type="date" />
                            <span asp-validation-for="DueDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="alert alert-info small">
                        <i class="bi bi-info-circle me-1"></i>
                        Once saved, the selected book will be marked as <strong>Borrowed</strong>
                        and removed from the available books list.
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i>Record Borrowing
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
