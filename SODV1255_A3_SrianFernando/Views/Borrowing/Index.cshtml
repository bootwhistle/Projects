@* Views/Borrowing/Index.cshtml - Table showing all borrowing transactions
   Displays reader name, book title, dates, and overdue status
   Navigation properties (Reader, Book) are pre-loaded by the repository *@

@model List<Borrowing>
@{
    ViewData["Title"] = "Borrowings";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-arrow-left-right me-2 text-primary"></i>Borrowings</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>New Borrowing
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No borrowing records yet. <a asp-action="Create">Record a borrowing.</a>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Reader</th>
                        <th>Book</th>
                        <th>Borrow Date</th>
                        <th>Due Date</th>
                        <th>Return Date</th>
                        <th>Status</th>
                        <th>Fine</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr class="@(b.IsOverdue ? "table-danger" : "")">
                            <td>@b.Id</td>
                            <td>@(b.Reader?.FullName ?? "—")</td>
                            <td>@(b.Book?.Title ?? "—")</td>
                            <td>@b.BorrowDate.ToString("MMM dd, yyyy")</td>
                            <td>@b.DueDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                @if (b.ReturnDate.HasValue)
                                {
                                    @b.ReturnDate.Value.ToString("MMM dd, yyyy")
                                }
                                else
                                {
                                    <span class="text-muted">Not returned</span>
                                }
                            </td>
                            <td>
                                @if (b.ReturnDate.HasValue)
                                {
                                    <span class="badge bg-success">Returned</span>
                                }
                                else if (b.IsOverdue)
                                {
                                    <span class="badge bg-danger">Overdue</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">Active</span>
                                }
                            </td>
                            <td class="@(b.OverdueFine > 0 ? "text-danger fw-bold" : "text-muted")">
                                @(b.OverdueFine > 0 ? "$" + b.OverdueFine.ToString("F2") : "—")
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@b.Id"
                                   class="btn btn-sm btn-outline-secondary me-1" title="Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@b.Id"
                                   class="btn btn-sm btn-outline-primary me-1" title="Edit / Return">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@b.Id"
                                   class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <p class="text-muted small mt-2">@Model.Count record(s) total.</p>
}
