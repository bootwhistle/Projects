@* Views/Borrowing/Delete.cshtml - Confirmation page before deleting a borrowing record
   Deleting an active borrowing will restore the book's availability *@

@model Borrowing
@{
    ViewData["Title"] = "Delete Borrowing";
}

<div class="row justify-content-center">
    <div class="col-md-6">

        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Borrowings</a></li>
                <li class="breadcrumb-item active">Delete</li>
            </ol>
        </nav>

        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="bi bi-trash me-2"></i>Confirm Delete</h5>
            </div>
            <div class="card-body">

                <p>Are you sure you want to delete this borrowing record?</p>

                <dl class="row">
                    <dt class="col-sm-4">Reader</dt>
                    <dd class="col-sm-8">@(Model.Reader?.FullName ?? "Unknown")</dd>

                    <dt class="col-sm-4">Book</dt>
                    <dd class="col-sm-8">@(Model.Book?.Title ?? "Unknown")</dd>

                    <dt class="col-sm-4">Borrow Date</dt>
                    <dd class="col-sm-8">@Model.BorrowDate.ToString("MMM dd, yyyy")</dd>

                    <dt class="col-sm-4">Returned?</dt>
                    <dd class="col-sm-8">@(Model.ReturnDate.HasValue ? "Yes" : "No — book will be marked available")</dd>
                </dl>

                <div class="alert alert-warning small">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    This action cannot be undone.
                    @if (!Model.ReturnDate.HasValue)
                    {
                        <span>The book will be marked as available after deletion.</span>
                    }
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i>Yes, Delete
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>
