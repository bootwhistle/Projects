@* Views/Account/Login.cshtml - Login page
   Accepts email and password; displays validation errors inline
   Uses the full layout but a centered card style *@

@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "_Layout"; // Explicit (also set by _ViewStart, included for clarity)
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card">
            <div class="card-body p-4">

                <h3 class="card-title text-center mb-4">
                    <i class="bi bi-lock-fill me-2 text-primary"></i>Sign In
                </h3>

                @* Display any login-level errors (e.g., "Invalid email or password") *@
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" placeholder="Password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Login
                    </button>
                </form>

                <hr />
                <p class="text-center mb-0 small">
                    Don't have an account?
                    <a asp-controller="Account" asp-action="Register">Register here</a>
                </p>

                @* Demo credentials hint for graders *@
                <p class="text-center text-muted small mt-2">
                    Demo: <code>admin@lms.com</code> / <code>admin123</code>
                </p>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
